# Python
.venv/
__pycache__/
*.py[cod]
*.egg-info/
.pytest_cache/
.ruff_cache/
.mypy_cache/
.coverage
dist/
build/

# IDE / OS
.DS_Store
.idea/
.vscode/
.env
.env.*
!.env.example

# 이미 공개한 자료는 추적하고 이후 생성되는 원자료와 파생물은 선택적으로 추가
data/raw/*
!data/raw/.gitkeep
data/interim/*
!data/interim/.gitkeep
data/reference/*
!data/reference/.gitkeep
data/processed/*
!data/processed/.gitkeep
outputs/*
!outputs/.gitkeep

# 새 Word 초안은 자동 추가 대상에서 제외
docs/*.docx

# 작업 진행 기록 도구
.fablize/

# Jupyter
.ipynb_checkpoints/
